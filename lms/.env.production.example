# =========================================================================
# KONFIGURASI LINGKUNGAN PRODUKSI SALAM LMS (STAI AL-ITTIHAD)
# Template resmi untuk deployment server produksi (Go-Live)
# =========================================================================

# Port Layanan Eksternal & Internal
SALAM_PORT=8080
PORT=5000

# Lingkungan Aplikasi
NODE_ENV=production
VITE_APP_ENV=production
VITE_APP_NAME="SALAM LMS - STAI AL-ITTIHAD"
VITE_APP_URL=https://salam.stai-alittihad.ac.id
VITE_API_URL=/api/v1

# Basis Data PostgreSQL Persisten (Ganti password kuat pada server riil)
POSTGRES_DB=salam_db
POSTGRES_USER=salam_admin
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_POSTGRES_KUAT_32_KARAKTER!
DATABASE_URL=postgresql://salam_admin:GANTI_DENGAN_PASSWORD_POSTGRES_KUAT_32_KARAKTER!@salam-postgres:5432/salam_db

# Keamanan Sesi & Kriptografi JWT (Wajib diisi string acak minimal 64 karakter)
JWT_SECRET=GANTI_DENGAN_KUNCI_RAHASIA_JWT_ACAK_MINIMAL_64_KARAKTER_PRODUKSI!
JWT_EXPIRES_IN=7d
VITE_SESSION_TIMEOUT_MINUTES=30
CORS_ORIGIN=https://salam.stai-alittihad.ac.id

# Penyimpanan Objek MinIO / S3-Compatible
STORAGE_DRIVER=s3
S3_ENDPOINT=http://salam-minio:9000
S3_BUCKET=salam-uploads
MINIO_ROOT_USER=salam_storage_admin
MINIO_ROOT_PASSWORD=GANTI_DENGAN_PASSWORD_MINIO_KUAT_32_KARAKTER!
S3_ACCESS_KEY=salam_storage_admin
S3_SECRET_KEY=GANTI_DENGAN_PASSWORD_MINIO_KUAT_32_KARAKTER!

# Integrasi Akademik SIAKAD
SIAKAD_API_URL=https://siakad.stai-alittihad.ac.id/api/v1
SIAKAD_SYNC_KEY=GANTI_DENGAN_TOKEN_SINKRONISASI_SIAKAD_RESMI!
VITE_SIAKAD_API_URL=https://siakad.stai-alittihad.ac.id/api/v1
VITE_SIAKAD_SYNC_KEY=GANTI_DENGAN_TOKEN_SINKRONISASI_SIAKAD_RESMI!

# Pembatasan Laju Permintaan (Rate Limiting)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Batasan Unggah Berkas Mahasiswa & Dosen
VITE_MAX_UPLOAD_SIZE_MB=10
VITE_ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.pptx,.ppt,.zip
