# =========================================================================
# SALAM LMS — STAI AL-ITTIHAD CIANJUR
# Environment Configuration (.env)
# =========================================================================

# 1. APPLICATION & PORTS
SALAM_PORT=8080
BACKEND_PORT=5000
VITE_API_BASE_URL=http://localhost:5000/api

# 2. NGROK PUBLIC TUNNEL CONFIGURATION
# Dapatkan authtoken gratis dari dashboard https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# (Opsional) Domain kustom/statis ngrok (misal: salam-lms.ngrok-free.app)
# NGROK_DOMAIN=salam-lms.ngrok-free.app

# 3. DATABASE POSTGRESQL
POSTGRES_DB=salam_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres2026!
DATABASE_URL=postgresql://postgres:postgres2026!@salam-postgres:5432/salam_db

# 4. OBJECT STORAGE (MINIO S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin2026!
S3_ENDPOINT=http://salam-minio:9000
S3_BUCKET=salam-uploads

# 5. SECURITY & JWT
JWT_SECRET=salam_jwt_secret_key_stai_alittihad_production_2026!
